{
  "rewrites": [
    { "source": "/b/:slug", "destination": "/api/og?slug=:slug" },
    { "source": "/((?!api/)[^.]*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
